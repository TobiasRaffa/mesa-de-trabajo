# Copiá este archivo como `.env.local` y completá lo que haga falta.
# `.env.local` no se sube al repositorio: son llaves, no código.
#
# En Netlify no va ningún archivo: las mismas variables se cargan en
# Site configuration -> Environment variables. Está explicado en DESPLIEGUE.md.


# --- Google Drive -----------------------------------------------------------
# La cuenta de servicio de la agencia. Es lo único imprescindible para que la
# aplicación muestre algo: sin esto no hay carpetas ni archivos.
#
# Salen del JSON que descarga Google Cloud, campos `client_email` y
# `private_key`. Está paso a paso en PREPARAR-DRIVE.md.
GOOGLE_SA_EMAIL=portal@tu-proyecto.iam.gserviceaccount.com

# La clave va entre comillas y en una sola línea, con los saltos escritos como
# \n. Así viene en el JSON: copiala tal cual, sin desarmarla.
GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"


# --- Supabase ---------------------------------------------------------------
# Dónde se guarda todo lo que la aplicación anota: clientes, estados de cada
# pieza, el calendario, los chats.
#
# Si no están, se guarda en archivos dentro de `datos/`, que sirve para
# trabajar en esta computadora y NO sirve en internet: el disco de Netlify es
# de solo lectura y se borra en cada despliegue. Desplegar sin esto falla en la
# compilación a propósito, para que no se pierdan datos en silencio.
#
# La llave es la **de servicio** (`service_role`), no la pública. Nunca sale
# del servidor. Salen de Supabase -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=


# --- La llave maestra de gestión ----------------------------------------------
# NO es la contraseña con la que entra el equipo: cada persona entra con su
# correo y la contraseña que eligió la primera vez. Esta llave hace dos cosas:
#
#   1. Firma las sesiones de gestión. Cambiarla echa a todo el mundo en el acto.
#   2. Abre la puerta SOLO mientras nadie del equipo tenga contraseña (el
#      arranque), para poder dar de alta a la primera persona. Después no abre.
#
# Un texto largo al azar; 32 letras o más. Quien configura el servidor es la
# única persona que tiene por qué saberla. En internet es obligatoria y sin
# ella no compila.
CLAVE_DE_ADMIN=


# --- Sesiones del portal ------------------------------------------------------
# Con qué se firma la galleta que recuerda que un cliente ya puso su clave.
# Si no está, la aplicación genera una sola y la guarda. Eso sirve acá.
#
# En internet es obligatoria y sin ella no compila: si la aplicación corre en
# más de una máquina, cada una generaría la suya y los clientes se caerían al
# saltar de una a otra. Cualquier texto largo al azar sirve; 32 letras o más.
SECRETO_DE_SESION=


# --- Correos (opcional) -------------------------------------------------------
# Los avisos que salen cuando el cliente aprueba o pide cambios, y el correo para
# elegir una contraseña nueva. Sin esto la aplicación anda igual: los avisos
# quedan anotados adentro, y «olvidé mi contraseña» solo deja el pedido en Admin.
# Cuenta de Gmail desde la que salen los correos, y su contraseña de aplicación
# (Cuenta de Google → Seguridad → Contraseñas de aplicaciones; requiere
# verificación en dos pasos). NO es la contraseña normal de la cuenta.
GMAIL_USUARIO=
GMAIL_CLAVE_DE_APLICACION=

# Dirección pública del sitio de GESTIÓN, sin barra al final. El link del correo
# de restablecer se arma con esto. Como el portal es otro sitio, no se puede
# tomar de la dirección del sitio que lo manda. Ej.: https://mesa-gestion.netlify.app
GESTION_URL=

# --- Sitio del portal (solo en el sitio que es solo portal) -------------------
# Poner SOLO_PORTAL=1 en el sitio del portal de clientes. Ahí `/gestion`,
# `/diagnostico` y las rutas de la agencia responden 404, y la tarea diaria no
# corre (la corre el sitio de gestión). En el sitio de gestión no va.
SOLO_PORTAL=

# --- Errores de producción (opcional) -----------------------------------------
# Adónde van los errores, para enterarse sin que nadie tenga que quejarse.
# Sin esto la aplicación anda igual y los errores solo quedan en el registro
# de Netlify, que nadie mira. Es el «DSN» de un proyecto de Sentry
# (sentry.io -> Settings -> Projects -> Client Keys). No es secreto: solo
# sirve para mandar errores. Está explicado en DESPLIEGUE.md.
NEXT_PUBLIC_SENTRY_DSN=
