# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Las llaves de verdad no se suben. El ejemplo si: es la lista de que hace
# falta configurar, y sin el nadie sabe que variables existen. Ojo con el
# orden, la excepcion tiene que ir DESPUES de la regla que la tapa.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ajustes y conversaciones de la agencia: son de esta maquina, no del
# proyecto. La barra del principio ancla la regla a la raiz: sin ella
# `datos/` tapa TAMBIEN src/admin/datos y src/portal/datos, que son
# codigo fuente. Paso: asi se perdio un archivo sin que nada avisara.
/datos/

# Copias de trabajo temporales que crean las herramientas (git worktree) para
# trabajar en paralelo sin pisarse. Son copias enteras del repositorio: si se
# subieran, o si el chequeo de tipos las mirara, todo aparecería repetido.
/.claude/worktrees/
